msgid "Start"
msgstr "Αρχή"

msgid "Check Update"
msgstr "Ελέγξτε την ενημέρωση"

msgid "Update canceled"
msgstr "Η ενημέρωση ακυρώνεται"

msgid "Error: speedyServiceScanUpdates folder not found."
msgstr "Σφάλμα: Δεν βρέθηκε ο φάκελος SpeedyServicesCanupDates."

msgid "Update completed successfully."
msgstr "Ενημέρωση ολοκληρώθηκε με επιτυχία."

msgid "Update finished. Restart GUI?"
msgstr "Η ενημέρωση ολοκληρώθηκε. Επανεκκινήστε το GUI;"

